{
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/portal-senior-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "Senior": {
    "BaseUrl": "http://45.236.79.210:8080",
    "ServicesPath": "g5-senior-services",
    "ServicePrefix": "sapiens",
    "Encryption": 0,
    "IdentificadorSistema": "PLATLOG",
    "TimeoutSeconds": 120,
    "TnsNaoVenda": [ "5102S", "6102S", "5949S", "6949S" ]
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://portalrefrio.web.app",
      "https://portalrefrio.firebaseapp.com"
    ]
  },
  "Jwt": {
    "Issuer": "PortalSeniorXT",
    "Audience": "PortalSeniorXT",
    "SecretKey": "",
    "ExpirationMinutes": 60
  }
}
